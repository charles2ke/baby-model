{
  "name": "baby-model",
  "version": "1.0.0",
  "description": "A private document model: train it on your own health, finance, professional and education documents, and ask questions answered only from them.",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "docs:build": "node scripts/build-docs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charles2ke/baby-model.git"
  },
  "keywords": [
    "personal-ai",
    "privacy",
    "rag",
    "self-hosted"
  ],
  "author": "charles2ke",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
